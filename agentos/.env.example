# ==========================================
# AgentOS Environment Configuration
# ==========================================

# Fetch.ai ASI:One LLM Credentials
# Obtain your key from https://asi1.ai/dashboard/api-keys
# Default model: asi1 | Fast: asi1-mini | Advanced: asi1-ultra
ASI1_API_KEY=
ASI1_MODEL=asi1
ASI1_BASE_URL=https://api.asi1.ai/v1

# Fetch.ai uAgent Identity & Agentverse Mailbox
# Seed phrase for your Fetch.ai agent identity. Leave blank to generate an ephemeral seed on first start.
AGENT_SEED_PHRASE=
AGENT_NAME=AgentOS-Desktop-Worker
AGENT_PORT=8001
AGENT_MAILBOX_KEY=

# Local Desktop Service Security
# Host and port for the local FastAPI service (binds to loopback 127.0.0.1 by default)
DESKTOP_HOST=127.0.0.1
DESKTOP_PORT=8000
# Token used to authenticate requests between UI/Relay and Desktop Agent
DEVICE_PAIRING_TOKEN=agentos-local-dev-token

# Filesystem Sandboxing & Workspace Restrictions
# Limit read/write file operations to this directory or its subdirectories
ALLOWED_WORKSPACE=./workspace

# Remote Dispatch Relay (Optional: for cloud agent to connect to local desktop over authenticated WebSocket/TLS)
RELAY_URL=

# Speech-to-Text Configuration
# Options: browser (native Web Speech fallback), faster-whisper (local whisper model: tiny, base, small)
STT_ENGINE=faster-whisper
WHISPER_MODEL_SIZE=base

# Execution safety limits
MAX_TASK_STEPS=15
MAX_TASK_DURATION_SECONDS=180
MAX_STEP_RETRIES=2
